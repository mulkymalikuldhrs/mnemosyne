{
  "name": "@memorix/memory",
  "version": "4.0.0",
  "private": false,
  "description": "Memorix v4 — The Biggest Free Multi-LLM Hub. 500+ models via Puter.js (FREE), BYOK, AI Agent with tool execution, semantic memory, RAG, MCP, multi-cloud storage, SaaS/IaaS ready. No backend needed.",
  "author": "Mulky Malikul Dhaher <mulkymalikuldhaher@email.com>",
  "license": "MIT",
  "homepage": "https://github.com/mulkymalikuldhrs/memorix#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mulkymalikuldhrs/memorix.git"
  },
  "bugs": {
    "url": "https://github.com/mulkymalikuldhrs/memorix/issues"
  },
  "bin": {
    "memorix-mcp": "./mcp-server/cli.js"
  },
  "files": [
    "mcp-server/cli.js",
    "mcp-server/dist/",
    "mcp-server/README.md",
    "prisma/",
    "README.md",
    "LICENSE"
