generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums (modeled as String with constraints at app level) ───

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  password            String?   // Hashed with bcryptjs (null for OAuth users)
  avatarUrl           String?
  plan                String    @default("FREE") // FREE | PRO | ENTERPRISE
  role                String    @default("user") // user | admin
  bio                 String?
  supabaseProjectUrl  String?
  openrouterApiKey    String?   // User can supply their own OpenRouter API key
  agentProfileId      String?   // Optional link to an active AgentProfile
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  notes               Note[]
  conversations       Conversation[]
  decisions           Decision[]
  apiKeys             ApiKey[]
  mcpSessions         McpSession[]
  dailynotes          DailyNote[]
  templates           Template[]
  favorites           Favorite[]
  canvases            Canvas[]

  // ─── v3.0.0 Relations ───
  cloudStorageAccounts CloudStorageAccount[]
  cloudFiles           CloudFile[]
  emailAccounts        EmailAccount[]
  emailMessages        EmailMessage[]
  integrations         Integration[]
  memoryEntities       MemoryEntity[]
  memoryRelations      MemoryRelation[]
  agentProfiles        AgentProfile[]        @relation("AgentOwner")
  activeAgentProfile   AgentProfile?         @relation("ActiveAgent", fields: [agentProfileId], references: [id])
  subscriptions        Subscription[]
  temporalSnapshots    TemporalSnapshot[]

  @@index([role])
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String                         // Raw text content
  markdown   String                         // Markdown-rendered content
  tags       String   @default("")          // Comma-separated tags
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks       NoteChunk[]
  sourceLinks  MemoryLink[]  @relation("SourceNote")
  targetLinks  MemoryLink[]  @relation("TargetNote")
  favorites    Favorite[]
  wikiSources  WikiLink[]    @relation("WikiSource")
  wikiTargets  WikiLink[]    @relation("WikiTarget")
  emailMessages EmailMessage[]

  @@index([userId])
  @@index([isArchived])
}

model NoteChunk {
  id         String   @id @default(cuid())
  noteId     String
  content    String                         // Chunk text content
  embedding  String                         // Stored as JSON array (SQLite doesn't support vector)
  chunkIndex Int                             // Position of this chunk within the note
  tokenCount Int                             // Number of tokens in this chunk
  createdAt  DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model MemoryLink {
  id            String   @id @default(cuid())
  sourceNoteId  String
  targetNoteId  String
  relationScore Float                          // Confidence score 0..1
  reason        String                         // Why these notes are linked
  autoLinked    Boolean  @default(true)        // True if auto-linked by AI
  createdAt     DateTime @default(now())

  sourceNote Note @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@index([sourceNoteId])
  @@index([targetNoteId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String                         // USER | ASSISTANT | SYSTEM
  content        String
  memoryRefs     String   @default("[]")        // JSON array of note IDs referenced
  tokenCount     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Decision {
  id             String    @id @default(cuid())
  userId         String
  title          String
  context        String                          // The situation / context
  decision       String                          // What was decided
  reasoning      String                          // Why this decision was made
  outcome        String?                         // What actually happened
  evaluation     String?                         // Retrospective evaluation
  status         String    @default("pending")   // pending | decided | revisited
  relatedNoteIds String    @default("[]")        // JSON array of related note IDs
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  key        String    @unique
  name       String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpSessions McpSession[]

  @@index([userId])
  @@index([key])
}

model McpSession {
  id             String    @id @default(cuid())
  userId         String
  apiKeyId       String
  clientId       String
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey  ApiKey  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
}

model DailyNote {
  id        String   @id @default(cuid())
  userId    String
  date      String   // Format: YYYY-MM-DD
  content   String   @default("")
  markdown  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Template {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  content     String
  category    String   @default("general") // general, daily, meeting, project, review
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  noteId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([userId])
}

model Canvas {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  data        String   // JSON string with nodes and edges
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WikiLink {
  id           String   @id @default(cuid())
  sourceNoteId String
  targetNoteId String
  linkText     String   // The [[link text]] as written
  createdAt    DateTime @default(now())

  sourceNote Note @relation("WikiSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note @relation("WikiTarget", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetNoteId, linkText])
  @@index([sourceNoteId])
  @@index([targetNoteId])
}

// ─── AI Memory Service Models ───

model AiMemory {
  id          String   @id @default(cuid())
  category    String   // conversation | decision | learning | pattern | preference
  key         String
  value       String   // JSON-serialized value
  context     String?
  confidence  Float    @default(1.0)
  accessCount Int      @default(0)
  isSynced    Boolean  @default(false)
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  accessedAt  DateTime @default(now())

  @@index([category])
  @@index([key])
  @@index([isSynced])
}

model SyncQueue {
  id          String    @id @default(cuid())
  entityType  String    // ai_memory, note, etc.
  entityId    String
  action      String    // create | update | delete
  data        String    // JSON-serialized entity data
  status      String    @default("pending") // pending | synced | failed
  attempts    Int       @default(0)
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([entityType, status])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// ─── Mnemosyne v1.0.0 — Universal AI/Human Memory Hub Models ────────
// ═══════════════════════════════════════════════════════════════════

model CloudStorageAccount {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // google_drive | terabox | s3 | dropbox | onedrive | local
  name          String
  accessToken   String    // Encrypted
  refreshToken  String    @default("") // Encrypted
  folderPath    String    @default("/")
  isEnabled     Boolean   @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  files    CloudFile[]

  @@index([userId])
  @@index([provider])
}

model CloudFile {
  id               String    @id @default(cuid())
  storageAccountId String
  userId           String
  providerFileId   String
  name             String
  mimeType         String    @default("")
  size             Int       @default(0)
  path             String    @default("")
  webUrl           String?
  thumbnailUrl     String?
  isSynced         Boolean   @default(true)
  lastModified     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  storageAccount CloudStorageAccount @relation(fields: [storageAccountId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storageAccountId])
  @@index([userId])
  @@index([mimeType])
  @@index([providerFileId])
}

model EmailAccount {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // gmail | imap | outlook
  email         String
  emailAddress  String    @default("")
  displayName   String    @default("")
  accessToken   String    // Encrypted
  refreshToken  String    @default("") // Encrypted
  imapHost      String?
  imapPort      Int?
  smtpHost      String?
  smtpPort      Int?
  isEnabled     Boolean   @default(true)
  isSyncing     Boolean   @default(false)
  syncCursor    String    @default("")
  syncError     String    @default("")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@index([userId])
  @@index([provider])
  @@unique([userId, email])
}

model EmailMessage {
  id             String    @id @default(cuid())
  emailAccountId String
  userId         String
  messageId      String
  fromAddr       String
  fromAddress    String    @default("")
  fromName       String    @default("")
  toAddr         String
  toAddresses    String    @default("[]") // JSON array of { address, name }
  subject        String    @default("")
  bodyText       String    @default("")
  bodyHtml       String    @default("")
  snippet        String    @default("")
  date           DateTime
  isRead         Boolean   @default(false)
  isStarred      Boolean   @default(false)
  isIngested     Boolean   @default(false)
  labels         String    @default("[]") // JSON array of label strings
  noteId         String?   // Optional link to a Note if ingested
  ingestedAt     DateTime?
  createdAt      DateTime  @default(now())

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  note         Note?        @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@unique([emailAccountId, messageId])
  @@index([emailAccountId])
  @@index([userId])
  @@index([messageId])
  @@index([date])
  @@index([isStarred])
  @@index([isIngested])
}

model Integration {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // composio | mcp_client | custom
  name          String
  config        String    // JSON configuration
  isEnabled     Boolean   @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
}

model MemoryEntity {
  id          String    @id @default(cuid())
  userId      String
  name        String
  type        String    // person | project | concept | topic | organization | tool | event
  description String    @default("")
  properties  String    @default("{}") // JSON object with entity-specific attributes
  validFrom   DateTime?
  validTo     DateTime?
  confidence  Float     @default(1.0)
  source      String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRelations   MemoryRelation[]  @relation("SourceEntity")
  targetRelations   MemoryRelation[]  @relation("TargetEntity")

  @@index([userId])
  @@index([type])
  @@index([name])
}

model MemoryRelation {
  id              String    @id @default(cuid())
  userId          String
  sourceEntityId  String
  targetEntityId  String
  relationType    String
  properties      String    @default("{}") // JSON object with relation-specific attributes
  validFrom       DateTime?
  validTo         DateTime?
  confidence      Float     @default(1.0)
  source          String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntity  MemoryEntity  @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity  MemoryEntity  @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationType])
}

model AgentProfile {
  id           String    @id @default(cuid())
  userId       String
  name         String
  description  String    @default("")
  systemPrompt String    @default("")
  capabilities String    @default("{}") // JSON object describing agent capabilities
  mcpEnabled   Boolean   @default(false)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user            User   @relation("AgentOwner", fields: [userId], references: [id], onDelete: Cascade)
  activeForUsers  User[] @relation("ActiveAgent")

  @@index([userId])
  @@index([mcpEnabled])
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String
  plan                String    @default("free") // free | pro | enterprise | iaas
  status              String    @default("active") // active | past_due | canceled
  stripeCustomerId    String?
  stripePriceId       String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([stripeCustomerId])
}

model TemporalSnapshot {
  id           String   @id @default(cuid())
  userId       String
  snapshotDate DateTime // The point-in-time this snapshot represents
  entities     String   @default("[]") // JSON array of entity states at this time
  relations    String   @default("[]") // JSON array of relation states at this time
  metadata     String   @default("{}") // JSON metadata about the snapshot
  source       String   @default("auto") // auto | manual | rebuild
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([snapshotDate])
}
