generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums (modeled as String with constraints at app level) ───

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  password            String?   // Hashed with bcryptjs (null for OAuth users)
  avatarUrl           String?
  plan                String    @default("FREE") // FREE | PRO | ENTERPRISE
  supabaseProjectUrl  String?
  openrouterApiKey    String?   // User can supply their own OpenRouter API key
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  notes         Note[]
  conversations Conversation[]
  decisions     Decision[]
  apiKeys       ApiKey[]
  mcpSessions   McpSession[]
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String                         // Raw text content
  markdown   String                         // Markdown-rendered content
  tags       String   @default("")          // Comma-separated tags
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks       NoteChunk[]
  sourceLinks  MemoryLink[]  @relation("SourceNote")
  targetLinks  MemoryLink[]  @relation("TargetNote")

  @@index([userId])
  @@index([isArchived])
}

model NoteChunk {
  id         String   @id @default(cuid())
  noteId     String
  content    String                         // Chunk text content
  embedding  String                         // Stored as JSON array (SQLite doesn't support vector)
  chunkIndex Int                             // Position of this chunk within the note
  tokenCount Int                             // Number of tokens in this chunk
  createdAt  DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model MemoryLink {
  id            String   @id @default(cuid())
  sourceNoteId  String
  targetNoteId  String
  relationScore Float                          // Confidence score 0..1
  reason        String                         // Why these notes are linked
  autoLinked    Boolean  @default(true)        // True if auto-linked by AI
  createdAt     DateTime @default(now())

  sourceNote Note @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@index([sourceNoteId])
  @@index([targetNoteId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String                         // USER | ASSISTANT | SYSTEM
  content        String
  memoryRefs     String   @default("[]")        // JSON array of note IDs referenced
  tokenCount     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Decision {
  id             String    @id @default(cuid())
  userId         String
  title          String
  context        String                          // The situation / context
  decision       String                          // What was decided
  reasoning      String                          // Why this decision was made
  outcome        String?                         // What actually happened
  evaluation     String?                         // Retrospective evaluation
  relatedNoteIds String    @default("[]")        // JSON array of related note IDs
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  key        String    @unique
  name       String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpSessions McpSession[]

  @@index([userId])
  @@index([key])
}

model McpSession {
  id             String    @id @default(cuid())
  userId         String
  apiKeyId       String
  clientId       String
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey  ApiKey  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
}
