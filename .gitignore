# ============================================================
# Memorix AI Memory SaaS — Git Ignore
# ============================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production build output
/build
/dist

# Environment & secrets (NEVER commit these)
.env
.env.local
.env.*.local
.env*.local
.env.*
!.env.example

# Database files (may contain user data)
*.db
*.db-journal
*.db-shm
*.db-wal
prisma/dev.db
prisma/*.db
db/
prisma/db/
prisma/migrations/

# Logs
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Security — never commit keys or certificates
*.pem
*.key
*.cert
*.crt
*.p12

# Secrets — icon source files
android-icon-source.png

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Bun (using bun, not npm)
package-lock.json
bun.lock

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# AI / IDE / Agent config
.claude
.z-ai-config
.zscripts/
local-*
prompt

# Skills directory
/skills/

# Agent context (internal)
/agent-ctx/

# Download directory (generated output)
/download/

# Upload directory (user files)
/upload/

# Worklog (internal)
worklog.md

# Playwright
test-results/
playwright-report/
playwright.config.ts
e2e/
e2e-full-test.mjs
e2e-test.mjs

# Android / Tauri / Capacitor
android/
src-tauri/
capacitor.config.ts

# Prisma generated (regenerated on build)
prisma/prisma-client/
