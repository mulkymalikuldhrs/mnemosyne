# ============================================================
# Mnemosyne — The Biggest Free Multi-LLM Hub & AI Agent Memory Center
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control!
# ============================================================

# --- Core ---
NODE_ENV="development"
DATABASE_URL="file:./dev.db"
PORT=3000

# --- Authentication ---
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption ---
# Used for encrypting OAuth tokens, API keys, etc.
# Generate: openssl rand -base64 32 (min 32 characters)
TOKEN_ENCRYPTION_KEY="change-me-in-production-32chars!!"

# --- Token TTL ---
ACCESS_TOKEN_TTL_SECONDS=900      # 15 minutes
REFRESH_TOKEN_TTL_DAYS=30         # 30 days

# --- LLM Providers (Optional — BYOK) ---
# Leave empty to use free LLM via Puter.js (500+ models, no API key needed!)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
DEEPSEEK_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# --- MCP Server ---
MCP_SERVER_PORT=4000
# API key for MCP server authentication. Required in production.
# Generate one from the Mnemosyne dashboard after signing in.
MNEMOSYNE_API_KEY=""

# --- Embedding ---
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION=768
EMBEDDING_API_URL=""
EMBEDDING_API_KEY=""

# --- Redis (Optional — for production rate limiting) ---
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# --- Storage Providers (Optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"

# --- Upload Limits ---
MAX_UPLOAD_BYTES=104857600  # 100MB

# --- Rate Limiting ---
LLM_RATE_LIMIT_RPM=20
STORAGE_RATE_LIMIT_RPM=10
AUTH_RATE_LIMIT_RPM=5
MCP_RATE_LIMIT_RPM=60
