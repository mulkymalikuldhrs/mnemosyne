# ============================================================
# Memorix AI Memory SaaS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control!
# ============================================================

# --- Database ---
# SQLite path for local development. For production, use PostgreSQL.
DATABASE_URL="file:./dev.db"

# --- NextAuth ---
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- AI (Optional — bring your own keys) ---
# OpenRouter API key for LLM chat features
OPENROUTER_API_KEY=""

# --- Redis (Optional — for production rate limiting) ---
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# --- MCP Server ---
# Port for MCP server (SSE transport, if enabled)
MCP_SERVER_PORT="4000"
# API key for MCP server authentication. Required in production.
# Generate one from the Memorix dashboard after signing in.
MEMORIX_API_KEY=""

# --- Embedding ---
# Embedding model configuration
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION="768"
# External embedding API URL (leave empty for built-in pseudo-embeddings)
EMBEDDING_API_URL=""
# API key for the external embedding service (if required)
EMBEDDING_API_KEY=""
