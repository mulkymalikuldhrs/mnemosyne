datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String   @default("[]") // JSON array stored as string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  relationsA NoteRelation[] @relation("NoteRelationsA")
  relationsB NoteRelation[] @relation("NoteRelationsB")

  @@index([title])
  @@index([createdAt])
  @@map("notes")
}

model NoteRelation {
  id             String   @id @default(cuid())
  noteAId        String
  noteBId        String
  relationScore  Float    @default(0)
  reason         String   @default("")
  createdAt      DateTime @default(now())

  noteA Note @relation("NoteRelationsA", fields: [noteAId], references: [id], onDelete: Cascade)
  noteB Note @relation("NoteRelationsB", fields: [noteBId], references: [id], onDelete: Cascade)

  @@unique([noteAId, noteBId])
  @@index([noteAId])
  @@index([noteBId])
  @@map("note_relations")
}

model Decision {
  id        String   @id @default(cuid())
  title     String
  context   String
  decision  String
  reasoning String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([createdAt])
  @@map("decisions")
}

model Conversation {
  id        String   @id @default(cuid())
  messages  String   @default("[]") // JSON array stored as string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("conversations")
}

model Pattern {
  id          String   @id @default(cuid())
  pattern     String
  description String   @default("")
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([pattern])
  @@map("patterns")
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String   @default("default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([key])
  @@map("api_keys")
}
